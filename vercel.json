{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "SITE_ORIGIN=https://vivlica.com npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hikaku-labo.vercel.app"
        }
      ],
      "destination": "https://vivlica.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vivlica.com"
        }
      ],
      "destination": "https://vivlica.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "destination": "/database",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "status"
        }
      ],
      "destination": "/database",
      "permanent": false
    },
    {
      "source": "/owner",
      "destination": "https://vivlica.vivlica.workers.dev/owner",
      "permanent": false
    },
    {
      "source": "/owner/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/owner/:path*",
      "permanent": false
    },
    {
      "source": "/console",
      "destination": "https://vivlica.vivlica.workers.dev/console",
      "permanent": false
    },
    {
      "source": "/console/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/console/:path*",
      "permanent": false
    },
    {
      "source": "/billing",
      "destination": "https://vivlica.vivlica.workers.dev/billing",
      "permanent": false
    },
    {
      "source": "/billing/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/billing/:path*",
      "permanent": false
    },
    {
      "source": "/api/owner",
      "destination": "https://vivlica.vivlica.workers.dev/api/owner",
      "permanent": false
    },
    {
      "source": "/api/owner/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/api/owner/:path*",
      "permanent": false
    },
    {
      "source": "/api/console",
      "destination": "https://vivlica.vivlica.workers.dev/api/console",
      "permanent": false
    },
    {
      "source": "/api/console/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/api/console/:path*",
      "permanent": false
    },
    {
      "source": "/api/billing",
      "destination": "https://vivlica.vivlica.workers.dev/api/billing",
      "permanent": false
    },
    {
      "source": "/api/billing/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/api/billing/:path*",
      "permanent": false
    },
    {
      "source": "/api/membership",
      "destination": "https://vivlica.vivlica.workers.dev/api/membership",
      "permanent": false
    },
    {
      "source": "/api/membership/:path*",
      "destination": "https://vivlica.vivlica.workers.dev/api/membership/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/owner/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/console/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/billing/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/owner/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/console/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/billing/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/membership/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
