# --- クライアント側 (Vite) ---
# 楽天アフィリエイトID。未設定でもソース内の既定値が使われます。
VITE_RAKUTEN_AFFILIATE_ID=

# --- サーバー側 (Vercel の Environment Variables に設定) ---
# accessKey を設定すると openapi.rakuten.co.jp を使用します。
# 未設定の場合は applicationId だけで通る app.rakuten.co.jp を使用します。
RAKUTEN_ACCESS_KEY=

# 以下は未設定ならソース内の既定値が使われます
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
SITE_URL=https://hikaku-labo.vercel.app
OPENAI_API_KEY=
