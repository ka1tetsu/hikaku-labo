# --- クライアント側 (Vite) ---
# 楽天アフィリエイトID。未設定でもソース内の既定値が使われます。
VITE_RAKUTEN_AFFILIATE_ID=

# --- サーバー側 (Vercel の Environment Variables に設定) ---
# 楽天市場APIは Application ID と Access Key の両方を要求します。
# どちらも https://webservice.rakuten.co.jp/app/list で確認できます。
#
# 従来版の市場API (app.rakuten.co.jp) は 2026-02-09 に廃止されており、
# 現在は openapi.rakuten.co.jp のみが有効です。

# ⚠️ シークレット。ソースには含めず、必ず Vercel の環境変数に設定してください。
RAKUTEN_ACCESS_KEY=

# 未設定ならソース内の既定値が使われます
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
SITE_URL=https://vivlica.com
OPENAI_API_KEY=

# --- Vivlica Travel: 航空券・ホテルのアフィリエイト (Vite / ビルド時の公開値) ---
# 未設定のパートナーは通常リンク（PR表示なし・報酬なし）になります。詳細: docs/TRAVEL-AFFILIATE-LINKS.md
# 楽天トラベルは VITE_RAKUTEN_AFFILIATE_ID（未設定時はソースの既定値）で計測。止める場合は true
VITE_RAKUTEN_TRAVEL_DISABLED=
# Trip.com アフィリエイトの Alliance ID と SID（数字）
VITE_TRIPCOM_ALLIANCE_ID=
VITE_TRIPCOM_SID=
# Booking.com アフィリエイトパートナーの aid（数字）
VITE_BOOKING_AID=
# ASPのディープリンク接頭辞（末尾に遷移先URLをエンコードして連結できる形、末尾は "="）
# 例: https://px.a8.net/svt/ejp?a8mat=XXXX&a8ejpredirect=  /  https://xxx.pxf.io/c/1/2/3?u=
VITE_SKYSCANNER_LINK_PREFIX=
VITE_EXPEDIA_LINK_PREFIX=

# --- 全ショップ価格比較 (/compare/) 詳細: docs/PRICE-COMPARE.md ---
# サーバー側: Yahoo!ショッピング itemSearch v3 の Client ID（未設定ならYahoo!の価格自動比較は無効）
YAHOO_SHOPPING_CLIENT_ID=
# ASP提携後に各ショップのディープリンク接頭辞を設定（末尾は "="）
VITE_AFF_AU_PAY=
VITE_AFF_QOO10=
VITE_AFF_BICCAMERA=

# --- Vivlica 本番ドメイン ---
# DNSとVercel Domainsを設定。canonical/OGP/sitemapはビルド時に生成。
SITE_ORIGIN=https://vivlica.com
# Yahoo!トラベル: Vivlica.comをA8に登録・掲載条件を確認した後だけ設定。
# 未設定時は新ドメインで通常の公式リンクにフォールバックします。
VITE_A8_TRAVEL_REGISTERED_ORIGIN=
VITE_A8_TRAVEL_DISABLED=
# 承認済みASPリンク（公開URL）。未設定・不正なURLは通常の公式リンク。
# VITE_AFF_URL_<サービスIDの大文字、ハイフンはアンダースコア> で統一。
# 例: IIJmio / ahamo / 光回線 / WordPress（実URLはASPから取得）
VITE_AFF_URL_IIJMIO=
VITE_AFF_URL_AHAMO=
VITE_AFF_URL_DOCOMO_HIKARI=
VITE_AFF_URL_XSERVER_WP=
# 管理用の有料AI生成APIを使う場合のみ設定。ブラウザ向けVITE_変数には入れない。
# OPENAI_API_KEYだけでは有料生成を有効化しません。Bearer認証で呼び出します。
AI_GENERATION_TOKEN=

# 複数サービスの承認済み成果URLを1つのJSONで設定できます（APIキーは入れない）。
# キーはカタログのサービスID。VITE_AFF_URL_<ID> の個別指定を優先します。
# VITE_AFFILIATE_LINKS={"iijmio":"ASP発行のhttps計測URL","xserver-wp":"ASP発行のhttps計測URL"}
VITE_AFFILIATE_LINKS=

# 詳細な管理者向け診断を使う場合のみVercelの秘密値に設定。未設定でも通常機能は動作します。
# VITE_変数には入れません。/api/diag の通常GETは外部APIを呼びません。
OPERATIONS_TOKEN=
