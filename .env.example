# --- クライアント側 (Vite) ---
# 楽天アフィリエイトID。未設定でもソース内の既定値が使われます。
VITE_RAKUTEN_AFFILIATE_ID=

# --- サーバー側 (Vercel の Environment Variables に設定) ---
# 楽天市場APIは Application ID と Access Key の両方を要求します。
# どちらも https://webservice.rakuten.co.jp/app/list で確認できます。
#
# 従来版の市場API (app.rakuten.co.jp) は 2026-02-09 に廃止されており、
# 現在は openapi.rakuten.co.jp のみが有効です。

# ⚠️ シークレット。ソースには含めず、必ず Vercel の環境変数に設定してください。
RAKUTEN_ACCESS_KEY=

# 未設定ならソース内の既定値が使われます
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
SITE_URL=https://hikaku-labo.vercel.app
OPENAI_API_KEY=
